# ==========================================
# QUÉ BASE USA EL BACKEND
# ==========================================
# Cambia UNA línea y reinicia Spring Boot.
# docker compose siempre usa las vars DOCKER_DB_*.
DB_TARGET=docker
# DB_TARGET=supabase

# ==========================================
# DOCKER (local)
# ==========================================
DOCKER_DB_USER=postgres
DOCKER_DB_PASSWORD=tu_contraseña_local
DOCKER_DB_NAME=taller_TIS
DOCKER_DB_PORT=5432

# ==========================================
# SUPABASE — Session pooler (IPv4)
# Dashboard → Connect → Session pooler
# No uses db.<PROJECT_REF>.supabase.co si tu red no tiene IPv6
# ==========================================
SUPABASE_DB_USER=postgres.<PROJECT_REF>
SUPABASE_DB_PASSWORD=tu_contraseña_supabase
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

PGADMIN_EMAIL=admin@nexacore.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ==========================================
# BACKEND (Spring Boot)
# ==========================================
SERVER_PORT=8080
JWT_SECRET=cambia_esta_clave_por_una_aleatoria_de_al_menos_32_caracteres
JWT_EXPIRATION_MS=86400000

# ==========================================
# FRONTEND (Vite / React)
# ==========================================
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ==========================================
# EMAIL (SMTP configurable)
# Desarrollo: Mailtrap sandbox → ver mails en mailtrap.io (NO llegan al correo real)
# Producción: Gmail App Password o SMTP del dominio (solo cambia estas vars)
# ==========================================
MAIL_ENABLED=true
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=tu_username_mailtrap
MAIL_PASSWORD=tu_password_mailtrap
MAIL_FROM=noreply@sigex.local

# Ejemplo Gmail (correo real):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu_correo@gmail.com
# MAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx
# MAIL_FROM=tu_correo@gmail.com
