# ==========================================
# QUÉ BASE USA EL BACKEND
# ==========================================
# Cambia UNA línea y reinicia Spring Boot.
# docker compose siempre usa las vars DOCKER_DB_*.
DB_TARGET=docker
# DB_TARGET=supabase

# ==========================================
# DOCKER (local)
# ==========================================
DOCKER_DB_USER=postgres
DOCKER_DB_PASSWORD=tu_contraseña_local
DOCKER_DB_NAME=taller_TIS
DOCKER_DB_PORT=5432

# ==========================================
# SUPABASE — Session pooler (IPv4)
# Dashboard → Connect → Session pooler
# No uses db.<PROJECT_REF>.supabase.co si tu red no tiene IPv6
# ==========================================
SUPABASE_DB_USER=postgres.<PROJECT_REF>
SUPABASE_DB_PASSWORD=tu_contraseña_supabase
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

PGADMIN_EMAIL=admin@nexacore.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ==========================================
# BACKEND (Spring Boot)
# ==========================================
SERVER_PORT=8080
JWT_SECRET=cambia_esta_clave_por_una_aleatoria_de_al_menos_32_caracteres
JWT_EXPIRATION_MS=86400000

# ==========================================
# FRONTEND (Vite / React)
# ==========================================
# Puerto del front. Si está ocupado, Vite pasa a 3001, 3002, ...
FRONTEND_PORT=3000
# URL que va en el correo de "olvidar contraseña".
# En PC: http://localhost:3000
# En móvil (misma WiFi): http://192.168.x.x:3000 (o el puerto que imprima Vite)
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRATION_MINUTES=30
# Relativo: el navegador/móvil hablan con el mismo host:puerto y Vite
# reenvía /api al backend. No hace falta cambiar la IP a mano.
VITE_API_BASE_URL=/api/v1
# Solo si abres el front por IP y el hot-reload falla en el móvil:
# VITE_HMR_HOST=192.168.x.x
# Orígenes exactos (opcional).
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Local + LAN (móvil misma WiFi). En prod usa orígenes exactos, no patterns abiertos.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*,http://10.*.*.*:*,http://172.16.*.*:*,http://172.17.*.*:*,http://172.18.*.*:*,http://172.19.*.*:*,http://172.20.*.*:*,http://172.21.*.*:*,http://172.22.*.*:*,http://172.23.*.*:*,http://172.24.*.*:*,http://172.25.*.*:*,http://172.26.*.*:*,http://172.27.*.*:*,http://172.28.*.*:*,http://172.29.*.*:*,http://172.30.*.*:*,http://172.31.*.*:*

# ==========================================
# SEGURIDAD
# ==========================================
# Swagger abierto en local (true). En prod: false o profile prod.
SWAGGER_ENABLED=true
# Solo true detrás de HTTPS (nginx/proxy TLS). Local: false.
REQUIRE_HTTPS=false
# Rate limit en login / forgot / reset (por IP)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# ==========================================
# EMAIL (SMTP configurable)
# Desarrollo: Mailtrap sandbox → ver mails en mailtrap.io (NO llegan al correo real)
# Producción: Gmail App Password o SMTP del dominio (solo cambia estas vars)
# ==========================================
MAIL_ENABLED=true
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=tu_username_mailtrap
MAIL_PASSWORD=tu_password_mailtrap
MAIL_FROM=noreply@sigex.local

# Ejemplo Gmail (correo real):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu_correo@gmail.com
# MAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx
# MAIL_FROM=tu_correo@gmail.com
